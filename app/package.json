{
  "name": "skylens",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "reverse:android": "adb reverse tcp:5000 tcp:5000",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "eslint . --format json",
    "build": "expo export --platform android",
    "build:web": "expo export --platform web",
    "test": "jest",
    "coverage:ci": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --config playwright.ci.config.ts",
    "e2e:report": "playwright show-report",
    "openapi:generate": "openapi-typescript ../backend/src/Api/openapi.json -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@microsoft/signalr": "10.0.0",
    "astronomy-engine": "^2.1.19",
    "expo": "~58.0.3",
    "expo-auth-session": "~58.0.14",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "satellite.js": "^7.1.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.3.0",
    "eslint": "9.39.3",
    "eslint-config-expo": "~58.0.4",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "jest-junit": "^17.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
